<Bindings>
  <Binding name="CLEANBOTTORTOISE_COMETOME" header="CLEANBOTTORTOISE">CleanBotTortoise.Bot("cometome")</Binding>
  <Binding name="CLEANBOTTORTOISE_ATTACK">CleanBotTortoise.Bot("attackstart")</Binding>
  <Binding name="CLEANBOTTORTOISE_STOP">CleanBotTortoise.Bot("attackstop")</Binding>
  <Binding name="CLEANBOTTORTOISE_PULL">CleanBotTortoise.Bot("pull")</Binding>
  <Binding name="CLEANBOTTORTOISE_AOE">CleanBotTortoise.Bot("aoe")</Binding>
  <Binding name="CLEANBOTTORTOISE_FOCUS">CleanBotTortoise.BotMark(8, "focusmark")</Binding>
  <Binding name="CLEANBOTTORTOISE_CC">CleanBotTortoise.BotMark(7, "ccmark")</Binding>
  <Binding name="CLEANBOTTORTOISE_CLEARMARKS">CleanBotTortoise.BotClearMarks()</Binding>
  <Binding name="CLEANBOTTORTOISE_PAUSE">CleanBotTortoise.Bot("pause")</Binding>
  <Binding name="CLEANBOTTORTOISE_UNPAUSE">CleanBotTortoise.Bot("unpause")</Binding>
  <Binding name="CLEANBOTTORTOISE_USEOBJECT">CleanBotTortoise.Bot("usegobject")</Binding>
</Bindings>
