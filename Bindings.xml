<Bindings>
  <Binding name="CLEANBOTV_COMETOME" header="CLEANBOTV">CleanBotV.Bot("cometome")</Binding>
  <Binding name="CLEANBOTV_ATTACK">CleanBotV.Bot("attackstart")</Binding>
  <Binding name="CLEANBOTV_STOP">CleanBotV.Bot("attackstop")</Binding>
  <Binding name="CLEANBOTV_PULL">CleanBotV.Bot("pull")</Binding>
  <Binding name="CLEANBOTV_AOE">CleanBotV.Bot("aoe")</Binding>
  <Binding name="CLEANBOTV_FOCUS">CleanBotV.BotMark(8, "focusmark")</Binding>
  <Binding name="CLEANBOTV_CC">CleanBotV.BotMark(7, "ccmark")</Binding>
  <Binding name="CLEANBOTV_CLEARMARKS">CleanBotV.BotClearMarks()</Binding>
  <Binding name="CLEANBOTV_PAUSE">CleanBotV.Bot("pause")</Binding>
  <Binding name="CLEANBOTV_UNPAUSE">CleanBotV.Bot("unpause")</Binding>
  <Binding name="CLEANBOTV_USEOBJECT">CleanBotV.Bot("usegobject")</Binding>
</Bindings>
